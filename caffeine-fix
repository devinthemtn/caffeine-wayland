#!/bin/bash
# Caffeine replacement using gnome-session-inhibit
# Prevents idle sleep while running

ICON_ACTIVE="☕"
ICON_INACTIVE="💤"
STATE_FILE="/tmp/caffeine-fix-state"
# Match only the inhibitor process itself: its command line must *start* with
# gnome-session-inhibit (optionally with a path) followed by our app id, so
# shells or editors that merely mention this text are never matched or killed.
INHIBIT_PATTERN='^([^ ]*/)?gnome-session-inhibit --app-id caffeine-fix-active( |$)'

toggle() {
    if pgrep -f "$INHIBIT_PATTERN" > /dev/null; then
        # Currently active - deactivate
        pkill -f "$INHIBIT_PATTERN"
        rm -f "$STATE_FILE"
        notify-send "Caffeine" "Sleep inhibit disabled" -i caffeine-cup-empty -t 2000
        echo "Caffeine OFF"
    else
        # Currently inactive - activate
        nohup gnome-session-inhibit \
            --app-id caffeine-fix-active \
            --reason "Preventing system sleep" \
            --inhibit idle \
            --inhibit-only > /dev/null 2>&1 &
        echo "active" > "$STATE_FILE"
        notify-send "Caffeine" "Sleep inhibit enabled" -i caffeine-cup-full -t 2000
        echo "Caffeine ON"
    fi
}

status() {
    if pgrep -f "$INHIBIT_PATTERN" > /dev/null; then
        echo "$ICON_ACTIVE Caffeine ACTIVE - sleep prevented"
        return 0
    else
        echo "$ICON_INACTIVE Caffeine INACTIVE - normal sleep"
        return 1
    fi
}

case "$1" in
    on)
        if ! pgrep -f "$INHIBIT_PATTERN" > /dev/null; then
            toggle
        fi
        ;;
    off)
        if pgrep -f "$INHIBIT_PATTERN" > /dev/null; then
            toggle
        fi
        ;;
    toggle)
        toggle
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {on|off|toggle|status}"
        echo ""
        status
        exit 1
        ;;
esac
