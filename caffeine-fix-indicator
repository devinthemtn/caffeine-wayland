#!/usr/bin/env python3
"""
Caffeine Fix Indicator - System tray indicator for sleep prevention
Uses gnome-session-inhibit to actually prevent sleep
"""

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('AyatanaAppIndicator3', '0.1')
from gi.repository import Gtk, GLib, AyatanaAppIndicator3 as AppIndicator
import subprocess
import signal
import os

APP_ID = "caffeine-fix"
ICON_ACTIVE = "caffeine-active"
ICON_INACTIVE = "caffeine-inactive"
ICON_PATH = os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps")
# Match only the inhibitor process itself: its command line must *start* with
# gnome-session-inhibit (optionally with a path) followed by our app id, so
# shells or editors that merely mention this text are never matched or killed.
INHIBIT_PATTERN = r"^([^ ]*/)?gnome-session-inhibit --app-id caffeine-fix-active( |$)"


# Note: AyatanaAppIndicator3 (GTK 3) is used rather than AyatanaAppIndicatorGlib
# because the latter exports its menu over org.gtk.Menus, which the GNOME
# AppIndicator extension cannot display -- only com.canonical.dbusmenu works.
class CaffeineIndicator:
    def __init__(self):
        self.inhibit_process = None

        # Create AppIndicator with icon path
        self.indicator = AppIndicator.Indicator.new(
            APP_ID,
            ICON_INACTIVE,
            AppIndicator.IndicatorCategory.APPLICATION_STATUS
        )
        self.indicator.set_icon_theme_path(ICON_PATH)
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("Caffeine Fix")

        # Create menu
        self.menu = Gtk.Menu()

        # Status item (non-clickable)
        self.status_item = Gtk.MenuItem(label="Status: Inactive")
        self.status_item.set_sensitive(False)
        self.menu.append(self.status_item)
        self.menu.append(Gtk.SeparatorMenuItem())

        # Toggle item
        self.toggle_item = Gtk.MenuItem(label="Enable")
        self.toggle_item.connect("activate", self.on_toggle)
        self.menu.append(self.toggle_item)
        self.menu.append(Gtk.SeparatorMenuItem())

        # Quit item
        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", self.on_quit)
        self.menu.append(quit_item)

        self.menu.show_all()
        self.indicator.set_menu(self.menu)

        self.last_state = None

        # Check initial state
        self.check_state()

    def check_state(self):
        """Check if inhibitor is active and update UI"""
        is_active = self.is_active()

        if is_active != self.last_state:
            self.last_state = is_active
            if is_active:
                self.indicator.set_icon_full(ICON_ACTIVE, "Caffeine Active")
                self.status_item.set_label("Status: Active (preventing sleep)")
                self.toggle_item.set_label("Disable")
            else:
                self.indicator.set_icon_full(ICON_INACTIVE, "Caffeine Inactive")
                self.status_item.set_label("Status: Inactive (normal sleep)")
                self.toggle_item.set_label("Enable")

        return True  # Continue periodic checking

    def is_active(self):
        """Check if caffeine is currently active"""
        try:
            result = subprocess.run(
                ["pgrep", "-f", INHIBIT_PATTERN],
                capture_output=True
            )
            return result.returncode == 0
        except Exception:
            return False

    def on_toggle(self, widget=None):
        """Toggle caffeine on/off"""
        if self.is_active():
            # Disable
            try:
                subprocess.run(["pkill", "-f", INHIBIT_PATTERN])
                self.inhibit_process = None
                self.show_notification("Caffeine disabled", "System will sleep normally")
            except Exception as e:
                print(f"Error disabling: {e}")
        else:
            # Enable
            try:
                self.inhibit_process = subprocess.Popen([
                    "gnome-session-inhibit",
                    "--app-id", "caffeine-fix-active",
                    "--reason", "Preventing system sleep",
                    "--inhibit", "idle",
                    "--inhibit-only"
                ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.show_notification("Caffeine enabled", "System sleep prevented")
            except Exception as e:
                print(f"Error enabling: {e}")

        # Update UI after short delay (one-shot)
        GLib.timeout_add(500, lambda: self.check_state() and False)

    def show_notification(self, title, message):
        """Show a desktop notification"""
        try:
            icon = ICON_ACTIVE if self.is_active() else ICON_INACTIVE
            subprocess.run([
                "notify-send", title, message,
                "-t", "2000",
                "-i", icon
            ], stderr=subprocess.DEVNULL)
        except Exception:
            pass

    def on_quit(self, widget=None):
        """Quit the indicator"""
        # Optionally disable caffeine before quitting
        # Uncomment next 4 lines if you want caffeine to turn off when quitting
        # if self.is_active():
        #     try:
        #         subprocess.run(["pkill", "-f", INHIBIT_PATTERN])
        #     except Exception:
        #         pass
        Gtk.main_quit()


def main():
    # Handle Ctrl+C gracefully
    signal.signal(signal.SIGINT, signal.SIG_DFL)

    indicator = CaffeineIndicator()

    # Periodic state check every 5 seconds
    GLib.timeout_add_seconds(5, indicator.check_state)

    Gtk.main()


if __name__ == "__main__":
    main()
